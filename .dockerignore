# The SPA is built inside the image (the `spa` stage), never copied in. A local
# `npm run build` leaves this tree on disk; excluding it keeps the build context
# small and stops a stale local bundle from shadowing the image's own build.
src/prepforge_chess/web/static/
# Node deps and vendored engine files are installed/regenerated by the stage.
node_modules/
web-src/public/engine/*
# ...except the committed manifest the Python stage fetches the wasm against.
!web-src/public/engine/stockfish.manifest.json
# ONNX weights are CDN-hosted; only the manifest ships.
web-src/public/maia3/*.onnx
web-src/public/maia3/*.onnx.data
