.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local app data and engine binaries
data/
engines/
out/
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Node / Vite frontend build tooling (build output in web/static IS committed)
node_modules/
.vite/
# Engine assets synced from node_modules by scripts/sync-stockfish.mjs; the
# BUILT copy under web/static/engine IS committed (Docker has no Node).
web-src/public/engine/
# Maia3 ONNX artifacts are generated by scripts/export_maia3_onnx.py and are too
# large for git (fp32 ~87MB, int8 ~24MB) — host them on a CDN/object store. The
# small manifest (hashes/versions/parity) IS tracked as the reproducibility record.
web-src/public/maia3/*.onnx
web-src/public/maia3/*.onnx.data
web-src/public/maia3/.stage-*/
web-src/public/maia3/.maia3.publish.lock
!web-src/public/maia3/maia3.manifest.json
# Safety net: a build copies public/ into the committed static dir; the Vite
# `exclude-maia3-weights` plugin strips the weights from the output, but never let
# them be committed even if that plugin is bypassed. The manifest still ships.
src/prepforge_chess/web/static/maia3/*.onnx
src/prepforge_chess/web/static/maia3/*.onnx.data
# Source maps: the deploy build ships without them (vite sourcemap defaults off).
# A local `VITE_SOURCEMAP=1` build emits .map files — never commit them (they
# bloat the wheel and publish the original source).
src/prepforge_chess/web/static/assets/*.map

# Secrets / runtime config — never commit real credentials (Stripe keys,
# SECRET_KEY, DATABASE_URL). Track .env.example as the documented template.
.env
.env.*
!.env.example

# Local screen recordings / scratch logs (dev artifacts, not source)
Captures/
*.log

# Editor and OS files
.idea/
.vscode/
terminals/
.DS_Store
Thumbs.db

# Local Claude Code agent config (launch.json / settings.local.json are per-machine)
.claude/

# Scratch analysis fixtures dropped at the repo root during manual testing
/analysis_test.pgn

# Local agent scratch logs (not source)
agent-tools/

# Durable repository-local Grok consult jobs (runtime only; never commit)
.prepforge/

# Scout v12 harness working data (game dumps, bias fits, route audits) - local only
tmp/

# Registered Module B scientific data for the authoritative worktree.
# Exact files and hashes are in research/module-b-non-git-data-registry.json.
/research/lichess-db-2013-01-burned/projection/
/research/lichess-db-2013-01-burned/plr-population-v1/
/research/lichess-db-2013-01-burned/identifiability-run/
/research/lichess-db-2014-01-power/projection/
/research/lichess-db-2014-02-power/projection/
/research/lichess-db-2014-03-power/projection/
/research/lichess-db-2014-04-power/projection/
/research/lichess-db-2014-05-power/projection/
/research/lichess-db-2014-06-power/projection/
/research/lichess-db-2014-07-power/projection/
/research/lichess-db-2014-08-power/projection/
/research/lichess-db-2014-09-power/projection/
/research/module-b-outcome-eval-multimonth/merged-outcome-join-2014-3q.ndjson
/research/tools/maia3/*.onnx
