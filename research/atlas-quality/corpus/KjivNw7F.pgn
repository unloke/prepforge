[StudyName "🍄 Ideas in the London System 🍄"]
[ChapterName "Quiz :]"]
[ChapterURL "https://lichess.org/study/KjivNw7F/fFnXDXWT"]
[Annotator "https://lichess.org/@/FunnyAnimatorJimTV"]
[UTCDate "2018.03.22"]
