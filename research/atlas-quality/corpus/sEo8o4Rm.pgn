[ChapterName "Colorado Gambit Declined"]
[ChapterURL "https://lichess.org/study/sEo8o4Rm/OLdsYI3k"]
[Annotator "https://lichess.org/@/FunnyAnimatorJimTV"]
[FEN "r1bqkbnr/ppppp1pp/2n5/5p2/4P3/5N2/PPPP1PPP/RNBQKB1R w Kk - 0 1"]
[SetUp "1"]
