[Opening "King's Pawn Game: Leonardis Variation"]
[StudyName "🏆 Opening Systems YOU can USE in your games"]
[ChapterName "King's Indian Attack"]
[ChapterURL "https://lichess.org/study/oBsew7N6/R2Iq95mP"]
[Annotator "https://lichess.org/@/FunnyAnimatorJimTV"]
[UTCDate "2017.08.28"]
