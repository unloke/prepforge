{
  "name": "prepforge-chess-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PrepForge Chess web frontend (Vite build into the Python package's static dir).",
  "scripts": {
    "sync-engine": "node scripts/sync-stockfish.mjs && node scripts/sync-ort.mjs",
    "dev": "npm run sync-engine && vite",
    "build": "npm run sync-engine && vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:watch": "npm run sync-engine && vite build --watch",
    "preview": "vite preview",
    "smoke:two-origin": "node scripts/two-origin-smoke.mjs",
    "gate:cross-origin": "node scripts/run-provider-harness-headless.mjs",
    "test": "vitest run",
    "test:research": "vitest run --config vitest.research.config.mjs",
    "lint:js": "eslint web-src scripts",
    "smoke:lazy-chunks": "node scripts/lazy-chunk-smoke.mjs",
    "smoke:stockfish": "node scripts/stockfish-browser-smoke.mjs",
    "smoke:prod-engine": "node scripts/prod-engine-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "playwright": "^1.50.1",
    "vite": "^6",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "onnxruntime-web": "^1.26.0",
    "stockfish": "19.0.0"
  }
}
